// Schema do banco de dados da aplicação de demonstração da Leucotron
// Documentação: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"

}

datasource db {
  provider  = "postgresql"

}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum FlowStatus {
  ABERTO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum AppointmentStatus {
  ABERTO
  CONFIRMADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum ExamAppointmentStatus {
  CONFIRMADO
  CANCELADO
}

enum OpportunityStatus {
  ABERTO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum TicketStatus {
  ABERTO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum TicketPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum RequesterType {
  CLIENTE
  CONCESSIONARIA
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum HotelReservationStatus {
  CONFIRMED
  CANCELLED
}

model Hotel {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  city      String
  state     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms        HotelRoom[]
  reservations HotelReservation[]

  @@index([city, state])
  @@map("hotels")
}

model HotelRoom {
  id          String   @id @default(uuid())
  hotelId     String
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel        Hotel              @relation(fields: [hotelId], references: [id])
  reservations HotelReservation[]

  @@unique([hotelId, name])
  @@index([hotelId, isActive])
  @@map("hotel_rooms")
}

model HotelReservation {
  id        String                 @id @default(uuid())
  code      String                 @unique
  hotelId   String
  roomId    String
  guestName String
  email     String?
  phone     String?
  checkIn   DateTime               @db.Date
  checkOut  DateTime               @db.Date
  status    HotelReservationStatus @default(CONFIRMED)
  pixCode   String
  pixLink   String
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  hotel Hotel     @relation(fields: [hotelId], references: [id])
  room  HotelRoom @relation(fields: [roomId], references: [id])

  @@index([hotelId, checkIn, checkOut])
  @@index([roomId, checkIn, checkOut])
  @@index([status])
  @@map("hotel_reservations")
}

// ─── Agendamento Médico ───────────────────────────────────────────────────────

model Specialty {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors      Doctor[]
  appointments Appointment[]

  @@map("specialties")
}

model Doctor {
  id          String   @id @default(uuid())
  name        String
  crm         String?  @unique
  isActive    Boolean  @default(true)
  specialtyId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  specialty    Specialty        @relation(fields: [specialtyId], references: [id])
  schedules    DoctorSchedule[]
  appointments Appointment[]

  @@map("doctors")
}

model DoctorSchedule {
  id        String   @id @default(uuid())
  doctorId  String
  weekday   Weekday
  startTime String   // "HH:MM"
  endTime   String   // "HH:MM"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@map("doctor_schedules")
}

model Appointment {
  id              String            @id @default(uuid())
  code            String            @unique
  patientName     String
  email           String?
  phone           String?
  specialtyId     String
  doctorId        String
  appointmentDate String            // "YYYY-MM-DD"
  startTime       String            // "HH:MM"
  endTime         String            // "HH:MM"
  reason          String?
  status          AppointmentStatus @default(ABERTO)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  specialty Specialty @relation(fields: [specialtyId], references: [id])
  doctor    Doctor    @relation(fields: [doctorId], references: [id])

  @@index([doctorId, appointmentDate])
  @@index([status])
  @@map("appointments")
}

// ─── Exames ───────────────────────────────────────────────────────────────────

model ExamType {
  id              String   @id @default(uuid())
  name            String   @unique
  durationMinutes Int      @default(15)
  preparation     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schedules    ExamSchedule[]
  appointments ExamAppointment[]

  @@map("exam_types")
}

model ExamSchedule {
  id         String   @id @default(uuid())
  examTypeId String
  weekday    Weekday
  startTime  String
  endTime    String
  createdAt  DateTime @default(now())

  examType ExamType @relation(fields: [examTypeId], references: [id])

  @@index([examTypeId, weekday])
  @@map("exam_schedules")
}

model ExamAppointment {
  id              String            @id @default(uuid())
  code            String            @unique
  examTypeId      String
  patientName     String
  email           String?
  phone           String?
  appointmentDate String
  startTime       String
  endTime         String
  status          ExamAppointmentStatus @default(CONFIRMADO)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  examType ExamType @relation(fields: [examTypeId], references: [id])

  @@index([examTypeId, appointmentDate])
  @@index([status])
  @@map("exam_appointments")
}

// ─── Comercial ────────────────────────────────────────────────────────────────

model Opportunity {
  id              String            @id @default(uuid())
  code            String            @unique
  contactName     String
  company         String?
  email           String?
  phone           String?
  need            String?
  hasPabx         Boolean?
  highVolume      Boolean?
  digitalChannels String?
  status  FlowStatus @default(ABERTO)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  agent           String?

  @@map("opportunities")
}

// ─── Suporte ──────────────────────────────────────────────────────────────────

model Ticket {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  company       String?
  email         String?
  phone         String?
  requesterType RequesterType
  product       String
  problem       String
  priority      TicketPriority @default(MEDIA)
  status  FlowStatus @default(ABERTO)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, priority])
  @@map("tickets")
}
model CodeSequence {
  id        String   @id // Vai armazenar os prefixos: "AGD", "CRM" ou "SUP"
  lastValue Int      @default(1001)
  updatedAt DateTime @updatedAt

  @@map("code_sequences")
}
